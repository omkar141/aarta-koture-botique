PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:3000
CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
# Keep this key unchanged after saving integration credentials; changing it makes saved credentials unreadable.
SUPER_ADMIN_NAME=Platform Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Set both super-admin values before the first server start to create the platform login.

# Optional Razorpay fallback values; preferred configuration is in the platform super-admin console.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional SMTP fallback values; preferred configuration is in the platform super-admin console.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=Your Boutique <mail@example.com>
# Comma-separated owner/admin addresses for inventory and role notifications
MAIL_NOTIFY_EMAILS=your-admin-address@example.com
